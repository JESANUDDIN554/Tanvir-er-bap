# -*- mode: python ; coding: utf-8 -*-
"""
PyInstaller spec for ClipMaker PC.
Build the .exe ON YOUR WINDOWS PC (PyInstaller cannot cross-compile
from Linux/macOS to Windows):

    pip install -r requirements.txt
    pip install pyinstaller
    pyinstaller ClipMakerPC.spec

The finished program is in dist/ClipMakerPC/.
Ship the whole ClipMakerPC folder (the .exe needs its _internal folder).
Requires ffmpeg on PATH (Install.bat handles this via winget).
"""

block_cipher = None

import os as _os
# Embedded app icon (generated from icon.ico) - written to disk at build time
# so the exe gets its icon even when icon.ico is not committed to git.
import base64 as _b64
_ICO_B64 = ""
if not _os.path.exists("icon.ico"):
    with open("icon.ico", "wb") as _f:
        _f.write(_b64.b64decode(_ICO_B64))
_icon = "icon.ico"

# NOTE: the app is a localhost HTTP server (waitress, pure python) +
# its own window via pywebview (WebView2; pythonnet/clr_loader ride
# along as pywebview's Windows deps), with a Chrome/Edge --app window
# as runtime fallback if the own window cannot open.
a = Analysis(
    ["app.py"],
    pathex=[],
    binaries=[],
    datas=[
        ("ui", "ui"),
        ("models", "models"),  # YuNet face-detection model for face tracking
        ("corepack.enc", "."),  # license-sealed core pack (prompts/styles)
        ("fonts", "fonts"),  # bundled OFL caption fonts (Caption Studio)
    ],
    hiddenimports=[
        "webview",
        "faster_whisper",
        "ctranslate2",
        "onnxruntime",
        "tokenizers",
        "yt_dlp",
        "waitress",
        "cv2",
        "numpy",
        "local_ai",
        "licensing",
        "ed25519",
        "integrity",
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="ClipMakerPC",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,  # windowed app, no console
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=_icon,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name="ClipMakerPC",
)
